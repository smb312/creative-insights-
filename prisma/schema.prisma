generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models (keep) ───────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  brandProfile   BrandProfile?
  adAccounts     AdAccount[]
  metaAds        MetaAd[]
  weeklyBriefs    WeeklyBrief[]
  monthlyTargets  MonthlyTarget[]
  marketingEvents MarketingEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Brand Profile (onboarding questionnaire) ─────────

model BrandProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  brandName             String
  websiteUrl            String?
  industry              String?
  industryOther         String?
  monthlyRevenueRange   String?
  businessAge           String?
  targetCustomer        String?
  averageOrderValue     Float?
  acquisitionFocus      String?
  uniqueDifferentiator  String?
  monthlyAdSpendRange   String?
  activeAdPlatforms     String[] @default([])
  usesCreatorContent    String?
  usesPartnershipAds    String?
  biggestChallenges     String[] @default([])
  challengesOther       String?
  competitor1           String?
  competitor2           String?
  competitor3           String?
  briefValuePreferences String[] @default([])
  additionalNotes       String?
  onboardingCompleted   Boolean  @default(false)
  onboardingStep        Int      @default(1)
  briefsPaused          Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Meta Ad Account Connection ───────────────────────

model AdAccount {
  id                   String          @id @default(cuid())
  userId               String
  metaAccountId        String          @unique
  metaAccountName      String?
  encryptedAccessToken String
  tokenExpiresAt       DateTime?
  tokenRefreshToken    String?
  status               AdAccountStatus @default(ACTIVE)
  lastSyncAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncLogs SyncLog[]

  @@index([userId])
}

// ─── Synced Meta Ad Data ──────────────────────────────

model MetaAd {
  id                    String   @id @default(cuid())
  userId                String
  adAccountId           String
  metaCampaignId        String?
  campaignName          String?
  metaAdSetId           String?
  adSetName             String?
  metaAdId              String
  adName                String?
  status                String?
  creativeType          String?
  creativeThumbnailUrl  String?
  primaryText           String?
  headline              String?
  callToAction          String?
  isPartnershipAd       Boolean  @default(false)
  creatorPageId         String?
  creatorName           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  performance MetaAdPerformance[]

  @@unique([userId, metaAdId])
  @@index([userId])
  @@index([isPartnershipAd])
}

model MetaAdPerformance {
  id              String   @id @default(cuid())
  metaAdId        String
  date            DateTime
  spend           Float    @default(0)
  impressions     Int      @default(0)
  reach           Int      @default(0)
  clicks          Int      @default(0)
  cpc             Float?
  cpm             Float?
  ctr             Float?
  conversions     Int      @default(0)
  conversionValue Float    @default(0)
  cpa             Float?
  roas            Float?
  frequency       Float?
  videoViews      Int?
  video3sViews    Int?
  videoThruplay   Int?
  hookRate        Float?
  holdRate        Float?
  createdAt       DateTime @default(now())

  metaAd MetaAd @relation(fields: [metaAdId], references: [id], onDelete: Cascade)

  @@unique([metaAdId, date])
  @@index([date])
  @@index([metaAdId])
}

// ─── Weekly Briefs ────────────────────────────────────

model WeeklyBrief {
  id              String    @id @default(cuid())
  userId          String
  briefDate       DateTime
  weekStart       DateTime
  weekEnd         DateTime
  subjectLine     String?
  bottomLine      String?
  briefMarkdown   String?
  briefHtml       String?
  briefStructured Json?
  analysisData    Json?
  shareToken      String    @unique @default(cuid())
  emailSent       Boolean   @default(false)
  emailSentAt     DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([briefDate])
  @@index([shareToken])
}

// ─── Monthly Targets (pacing & forecasting) ──────────

model MonthlyTarget {
  id             String   @id @default(cuid())
  userId         String
  month          DateTime // first day of the month, e.g. 2026-02-01
  revenueGoal    Float?
  adSpendBudget  Float?
  targetRoas     Float?
  targetCpa      Float?
  targetOrders   Int?
  targetNewCac   Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
  @@index([month])
}

// ─── Marketing Events (calendar) ─────────────────────

model MarketingEvent {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?
  eventType     String    // product_launch, promotion, influencer_campaign, seasonal, content_shoot, email_campaign, pr_press, event, other
  startDate     DateTime
  endDate       DateTime?
  adSpendBoost  Float?    // expected daily ad spend increase
  revenueTarget Float?    // revenue goal for this event
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startDate])
}

// ─── Sync Logging ─────────────────────────────────────

model SyncLog {
  id          String     @id @default(cuid())
  adAccountId String
  status      SyncStatus @default(PENDING)
  message     String?
  startedAt   DateTime   @default(now())
  completedAt DateTime?

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@index([adAccountId])
}

// ─── Enums ────────────────────────────────────────────

enum AdAccountStatus {
  ACTIVE
  PAUSED
  DISCONNECTED
  TOKEN_EXPIRED
  PENDING_SELECTION
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}
