# Database
DATABASE_URL="postgresql://user:password@localhost:5432/creative_insights"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta/Facebook App
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

# Encryption key for storing Meta access tokens at rest
ENCRYPTION_SECRET="your-encryption-secret-generate-with-openssl-rand-base64-32"

# Cron job authentication
CRON_SECRET="your-cron-secret"
